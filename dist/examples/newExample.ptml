<?ptml encoding="UTF-8" terminal-resize="reflow" console-instance="default"?>
<terminal x-align="center">
    <block title="System Monitor" width="48" padding="1">
        <column gap="1">
            <row gap="1">
                <text foreground="limegreen" font="bold">● ONLINE</text>
                <text foreground="gray">System Dashboard</text>
            </row>

            <row>
                <hr orientation="horizontal" />
                <text font="bold">Resource Usage</text>
            </row>


            <row gap="1">
                <text>CPU</text>
                <progress value="7" max="10" show-value="true" />
            </row>

            <row gap="1">
                <text>RAM</text>
                <progress value="4" max="10" show-value="true" />
            </row>

            <row>
                <hr orientation="horizontal" />
                <text font="bold">Services</text>
            </row>

            <row gap="1">
                <spinner type="dots" interval="250ms" duration="1s" />
                <text>Network service</text>
            </row>

            <row gap="1">
                <text foreground="limegreen">✓</text>
                <text>Storage service</text>
            </row>

            <row>
                <hr orientation="horizontal" />
            </row>
            <row>
                <text foreground="gray" font="italic">
                    Monitoring system resources...
                </text>
            </row>
        </column>
    </block>
    <cursor visible="false"/>
</terminal>
