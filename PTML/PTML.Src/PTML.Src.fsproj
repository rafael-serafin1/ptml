<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <OutPath>dist\build\</OutPath>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <AssemblyName>ptml</AssemblyName>
  </PropertyGroup>

  <ItemGroup><Compile Include="utils/Utils.fs" />
    <None Include=".env.example" />
    <Compile Include="utils/Messager.fs" />
    <Compile Include="components/elements/abstracts/Notification.fs" />
    <Compile Include="components/elements/abstracts/Collections.fs" /> 
    <Compile Include="components/elements/abstracts/List.fs" />
    <Compile Include="components/elements/abstracts/Code.fs" />
    <Compile Include="components/elements/abstracts/Cursor.fs" />
    
    <Compile Include="components/elements/concretes/Spinner.fs" />
    <Compile Include="components/elements/concretes/Progress.fs" />
    <Compile Include="components/elements/concretes/Escape.fs" />
    <Compile Include="components/elements/concretes/Frame.fs" />
    <Compile Include="components/elements/concretes/DirTree.fs" />
    <Compile Include="components/elements/concretes/Hyper.fs" />
    <Compile Include="components/elements/concretes/Char.fs" />
    <Compile Include="attrs/FontCode.fs" />
    <Compile Include="attrs/Global.fs" />
    <Compile Include="cmd/CSI.fs" />
    <Compile Include="cmd/OSC.fs" />
    <Compile Include="attrs/PiAttrs.fs" />
    <Compile Include="attrs/Overflow.fs" />
    <Compile Include="components/elements/abstracts/Terminal.fs" />
    <Compile Include="Token.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Parser.fs" /> 
    <Compile Include="components/psi/Snippet.fs" />
    <Compile Include="components/psi/Content.fs" />
    <Compile Include="components/psi/Id.fs" />
    <Compile Include="Tree.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="helper/Drawers.fs" />
    <Compile Include="attrs/OverflowFunctions.fs" />
    <Compile Include="Render.fs" />
    
    <Compile Include="Buffer.fs" />
    <Compile Include="BufferState.fs" />
    <Compile Include="Diff.fs" />
    <Compile Include="DiffRenderer.fs" />
    <Compile Include="Output.fs" />
    <Compile Include="components/elements/abstracts/Layer.fs" />
    <Compile Include="components/psi/ContentExecution.fs" />
    <Compile Include="main/Runner.fs" />
    <Compile Include="ErrorHandling.fs" />
    <Compile Include="main/Watch.fs" />
    <Compile Include="main/Debug.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="application.json"></None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PTML.Complexs\PTML.Complexs.csproj" />
    <ProjectReference Include="..\PTML.DOM\PTML.DOM.fsproj" />
  </ItemGroup>

</Project>
