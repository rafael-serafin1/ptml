<?ptml encoding="UTF-8" terminal-resize="static"?>
<column gap="1">
    <list ofstyle="enum" before="Step " after=" ">
        <column>
            <text>Create a PTML file.</text>
            <text>Run the PTML file.</text>
        </column>
    </list>
    <list after=" ">
        <text>Horizontal item one</text>
        <text>Horizontal item two</text>
    </list>
    <list ofstyle="lower-alphabet" after=" ">
        <row gap="1">
            <text>Letter item one</text>
            <text>Letter item two</text>
        </row>
    </list>
    <list ofstyle="upper-alphabet" before="(" after=") ">
        <column>
            <text>Upper item</text>
        </column>
    </list>
    <list ofstyle="unorder" after=" ">
        <column>
            <text>Unordered item</text>
        </column>
    </list>

    <code src="hello.lua" execute-method="async">
        print("hello World!")
        let health = 5
    </code>
</column>
