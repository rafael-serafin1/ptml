<?ptml encoding="UTF-8" terminal-resize="static" console-instance="clear"?>
<terminal x-align="start">
    <row gap="1">
        <column>
            <row gap="1">
                <text>hello</text>
                <text>world</text>            
            </row>
        </column>
        <cursor shape="underline" color="#837878" /> 
        <text>Hello World! <char codename="del"/></text>
    </row>
</terminal>